# Azure DevOps Configuration
# Get these from your Azure DevOps organization settings
ADO_ORG_URL=https://dev.azure.com/your-organization
ADO_PROJECT=YourProjectName
ADO_PAT=your-personal-access-token-here

# Custom Field Mappings (Reference Names from your ADO Process)
# Find these in Organization Settings > Process > [Your Process] > Fields
# Common defaults (may need to be changed for your organization):
ADO_FIELD_BOARD_COLUMN=System.BoardColumn
ADO_FIELD_DEPLOY_DATE=Custom.DeployDate
ADO_FIELD_TARGET_DATE=Microsoft.VSTS.Scheduling.TargetDate

# Link Type for Parent/Child relationships
# Check in Organization Settings > Process > [Your Process] > Link Types
# Common values: System.LinkTypes.Hierarchy-Forward (default), System.LinkTypes.Hierarchy-Reverse
ADO_LINK_TYPE=System.LinkTypes.Hierarchy-Forward

# Server Configuration
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173